# Copy this file to .env and fill in your key. NEVER commit .env to GitHub.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Use a model that your key can access (see the README for how to list them).
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-latest
CORS_ORIGINS=http://localhost:5173
